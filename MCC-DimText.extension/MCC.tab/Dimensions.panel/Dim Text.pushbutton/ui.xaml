<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dim Text" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="lbl_count" Margin="0,0,0,6"/>

        <!-- segment picker (hidden when no strings are selected) -->
        <Border Grid.Row="1" x:Name="grp_segs" BorderBrush="#BBBBBB"
                BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="String segments to change" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="All" Width="44" Height="22" Margin="0,0,4,0"
                                Click="segs_all"/>
                        <Button Content="None" Width="44" Height="22"
                                Click="segs_none"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnl_segs"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Dimension Value -->
        <GroupBox Grid.Row="2" Header="Dimension Value" Padding="8,4" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Row="0" Grid.Column="0" x:Name="rb_leave"
                             Content="Leave as is" Margin="0,3,16,3" IsChecked="True"
                             Checked="value_mode_changed"/>
                <RadioButton Grid.Row="1" Grid.Column="0" x:Name="rb_actual"
                             Content="Use actual value" Margin="0,3,16,3"
                             Checked="value_mode_changed"/>
                <RadioButton Grid.Row="2" Grid.Column="0" x:Name="rb_replace"
                             Content="Replace with text" Margin="0,3,16,3"
                             Checked="value_mode_changed"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_override"
                         Height="26" Padding="4,3" VerticalContentAlignment="Center"
                         IsEnabled="False" GotFocus="override_focus"/>
            </Grid>
        </GroupBox>

        <!-- Text Fields -->
        <GroupBox Grid.Row="3" Header="Text Fields" Padding="8,4" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Above" Margin="0,0,0,3"/>
                        <TextBox x:Name="txt_above" Height="26" Padding="4,3"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Prefix" Margin="0,0,0,3"/>
                        <TextBox x:Name="txt_prefix" Height="26" Padding="4,3"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Value" Margin="0,0,0,3"/>
                        <TextBox x:Name="txt_preview" Height="26" Padding="4,3" IsReadOnly="True"
                                 Background="#EEEEEE" HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center" Text="13'-6 3/8&quot;"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Suffix" Margin="0,0,0,3"/>
                        <TextBox x:Name="txt_suffix" Height="26" Padding="4,3"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Below" Margin="0,0,0,3"/>
                        <TextBox x:Name="txt_below" Height="26" Padding="4,3"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="chk_space" IsChecked="True" Margin="0,0,0,4"
                          Content="Add a space between prefix/suffix and the value"/>
                <CheckBox x:Name="chk_clear"
                          Content="Clear fields left blank (otherwise blank = leave as is)"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Dimension style" Margin="0,0,0,3"/>
            <ComboBox x:Name="cmb" Height="26"/>
        </StackPanel>

        <DockPanel Grid.Row="5">
            <CheckBox x:Name="chk_default" Content="Set as default"
                      VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                        IsCancel="True" Click="cancel_click"/>
                <Button Content="Apply" Width="80" Height="28"
                        IsDefault="True" Click="ok_click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
