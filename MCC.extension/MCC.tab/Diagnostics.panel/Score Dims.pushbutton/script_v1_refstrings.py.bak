# -*- coding: utf-8 -*-
"""Scores an auto-dimensioned view against a hand-dimensioned one.

Pick the REFERENCE view (the finished sheet view) and the TEST view (a
duplicate of it that Dim Soffit ran on - same model elements, so element
ids line up). Every dimension becomes a signature: the set of
(reference kind, element id) it touches. A test dim MATCHES when a hand
dim has the same signature; a LOOSE match shares the same elements but
touches different faces of them (near vs far side of a beam, say).

Reports recall (hand dims the tool reproduced) and precision (tool dims a
detailer also drew) per object category, then lists what was missed and
what was extra with values, so each can be looked at. Read-only."""
__title__ = "Score\nDims"
__author__ = "MCC ENG"

from mcc_compat import eid_int, make_eid
from collections import OrderedDict
from pyrevit import revit, DB, forms, script
from mcc_dim import is_dim

doc = revit.doc
out = script.get_output()

plans = sorted((v for v in DB.FilteredElementCollector(doc).OfClass(DB.View)
                if isinstance(v, DB.ViewPlan) and not v.IsTemplate),
               key=lambda v: v.Name)
names = OrderedDict((v.Name, v) for v in plans)
ref_name = forms.SelectFromList.show(list(names.keys()), title="REFERENCE view "
                                     "(hand-dimensioned)", button_name="Next")
if not ref_name:
    script.exit()
test_name = forms.SelectFromList.show(
    [k for k in names.keys() if k != ref_name],
    title="TEST view (auto-dimensioned copy)", button_name="Score")
if not test_name:
    script.exit()
ref_view, test_view = names[ref_name], names[test_name]


def kind_of(e):
    if e is None:
        return "?"
    if isinstance(e, DB.Grid):
        return "grid"
    if isinstance(e, DB.Floor):
        return "slab"
    try:
        cn = e.Category.Name
    except Exception:
        return "?"
    return {"Walls": "wall", "Structural Framing": "beam",
            "Structural Columns": "column", "Columns": "column",
            "Detail Items": "detail"}.get(cn, cn.lower())


def category(kinds):
    """Object category a dim belongs to, from what it touches."""
    ks = set(kinds)
    for k in ("beam", "opening", "slab", "wall", "column", "detail"):
        if k in ks:
            return k
    return "grid" if ks == {"grid"} else "other"


def signatures(view):
    sigs = []
    for dim in DB.FilteredElementCollector(doc, view.Id).OfClass(DB.Dimension):
        if not is_dim(dim):
            continue
        strict, loose, kinds = [], [], []
        for ref in dim.References:
            e = doc.GetElement(ref.ElementId)
            k = kind_of(e)
            eid = eid_int(e.Id) if e else -1
            # faces of one element differ by the reference's stable string
            try:
                srep = ref.ConvertToStableRepresentation(doc)
            except Exception:
                srep = str(eid)
            strict.append((k, eid, srep))
            loose.append((k, eid))
            kinds.append(k)
        try:
            vals = " | ".join((sg.ValueString or "") for sg in
                              (list(dim.Segments) if dim.NumberOfSegments > 1
                               else [dim]))
        except Exception:
            vals = ""
        sigs.append({"id": eid_int(dim.Id), "strict": frozenset(strict),
                     "loose": frozenset(loose), "cat": category(kinds),
                     "kinds": " > ".join(kinds), "vals": vals})
    return sigs


ref_sigs = signatures(ref_view)
test_sigs = signatures(test_view)
# ignore grid-only strings on both sides (Dim Grids is its own button)
ref_sigs = [s for s in ref_sigs if s["cat"] != "grid"]
test_sigs = [s for s in test_sigs if s["cat"] != "grid"]

ref_strict = {}
ref_loose = {}
for s in ref_sigs:
    ref_strict.setdefault(s["strict"], []).append(s)
    ref_loose.setdefault(s["loose"], []).append(s)
test_strict = {}
test_loose = {}
for s in test_sigs:
    test_strict.setdefault(s["strict"], []).append(s)
    test_loose.setdefault(s["loose"], []).append(s)

cats = sorted(set(s["cat"] for s in ref_sigs + test_sigs))
rows = []
missed, extra = [], []
for cat in cats:
    r = [s for s in ref_sigs if s["cat"] == cat]
    t = [s for s in test_sigs if s["cat"] == cat]
    r_hit = sum(1 for s in r if s["strict"] in test_strict)
    r_loose = sum(1 for s in r if s["strict"] not in test_strict
                  and s["loose"] in test_loose)
    t_hit = sum(1 for s in t if s["strict"] in ref_strict)
    t_loose = sum(1 for s in t if s["strict"] not in ref_strict
                  and s["loose"] in ref_loose)
    rows.append([cat, len(r), len(t),
                 "{}%".format(100 * (r_hit + r_loose) // len(r)) if r else "-",
                 "{}%".format(100 * r_hit // len(r)) if r else "-",
                 "{}%".format(100 * (t_hit + t_loose) // len(t)) if t else "-"])
    missed += [s for s in r if s["strict"] not in test_strict
               and s["loose"] not in test_loose]
    extra += [s for s in t if s["strict"] not in ref_strict
              and s["loose"] not in ref_loose]

out.print_md("## Score: {} vs hand-dimensioned {}".format(test_name, ref_name))
out.print_table(rows, columns=["category", "hand dims", "tool dims",
                               "recall (loose)", "recall (exact)",
                               "precision (loose)"])
out.print_md("**Recall** = share of the detailer's dims the tool reproduced "
             "(loose: same elements, any face). **Precision** = share of the "
             "tool's dims a detailer also drew. Grid-only strings excluded.")
if missed:
    out.print_md("### Missed by the tool ({}) - hand dims with no counterpart"
                 .format(len(missed)))
    out.print_table([[out.linkify(make_eid(s["id"])), s["cat"], s["kinds"],
                      s["vals"]] for s in missed[:150]],
                    columns=["hand dim", "cat", "references", "values"])
if extra:
    out.print_md("### Extra from the tool ({}) - no hand counterpart"
                 .format(len(extra)))
    out.print_table([[out.linkify(make_eid(s["id"])), s["cat"], s["kinds"],
                      s["vals"]] for s in extra[:150]],
                    columns=["tool dim", "cat", "references", "values"])
