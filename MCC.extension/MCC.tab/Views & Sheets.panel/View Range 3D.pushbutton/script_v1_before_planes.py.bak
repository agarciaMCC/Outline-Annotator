# -*- coding: utf-8 -*-
"""Show a plan's view range in 3D.

Run from a soffit plan: creates / updates the 3D view MCC VIEW RANGE 3D
with a section box cut to the plan's crop (rotated crops too) and to its
view range (lowest to highest of top / cut / bottom / view depth), opens
it and tiles the windows so the plan and the 3D sit side by side. Change
the view range, run again (from the plan or the 3D view) to refresh."""
__title__ = "View Range\n3D"
__author__ = "MCC ENG"
__persistentengine__ = True     # keeps the floating window alive

from pyrevit import revit, DB, UI, forms, script

doc = revit.doc
uidoc = revit.uidoc
output = script.get_output()
cfg = script.get_config()

# =====================================================================
VIEW_NAME = "MCC VIEW RANGE 3D"
XY_PAD = 1.0                  # ft added around the crop
UNLIMITED = 50.0              # ft used for an "Unlimited" view depth
POPOUT = True                 # show the 3D in its own floating window
TILE = True                   # (POPOUT off) open as a tab and tile windows
# =====================================================================

PLANES = [("Top", DB.PlanViewPlane.TopClipPlane),
          ("Cut plane", DB.PlanViewPlane.CutPlane),
          ("Bottom", DB.PlanViewPlane.BottomClipPlane),
          ("View depth", DB.PlanViewPlane.ViewDepthPlane)]
cfg_key = "vr3d_last_" + "".join(c if c.isalnum() else "_"
                                 for c in (doc.Title or "model"))


def ft_in(v):
    """Feet -> 4'-0" style (signed)."""
    sign = "-" if v < -1e-9 else ""
    v = abs(v)
    ft = int(v)
    inch = round((v - ft) * 12.0 * 8) / 8.0
    if inch >= 12:
        ft, inch = ft + 1, 0
    s = ("%g" % inch)
    return "{}{}'-{}\"".format(sign, ft, s)


# ---------------------------------------------------------- which plan
view = doc.ActiveView
if isinstance(view, DB.View3D) and view.Name == VIEW_NAME:
    last = cfg.get_option(cfg_key, 0) or 0
    plan = doc.GetElement(DB.ElementId(int(last))) if last else None
    if not isinstance(plan, DB.ViewPlan):
        forms.alert("Run this from a plan view first.", exitscript=True)
    view = plan
if not isinstance(view, DB.ViewPlan) or view.IsTemplate:
    forms.alert("Open a plan view (soffit plan) and run View Range 3D.",
                exitscript=True)

levels = sorted(DB.FilteredElementCollector(doc).OfClass(DB.Level),
                key=lambda l: l.ProjectElevation)
assoc = view.GenLevel


def resolve(lid):
    """Level for a view-range level id (handles Associated / Above /
    Below / Unlimited). Returns (level or None, label)."""
    if lid == DB.PlanViewRange.Current:
        return assoc, "Associated Level ({})".format(assoc.Name)
    if lid == DB.PlanViewRange.Unlimited:
        return None, "Unlimited"
    i = next((k for k, l in enumerate(levels) if l.Id == assoc.Id), None)
    if lid == DB.PlanViewRange.LevelAbove:
        l = levels[i + 1] if i is not None and i + 1 < len(levels) else None
        return l, "Level Above ({})".format(l.Name if l else "none")
    if lid == DB.PlanViewRange.LevelBelow:
        l = levels[i - 1] if i else None
        return l, "Level Below ({})".format(l.Name if l else "none")
    l = doc.GetElement(lid)
    return (l, l.Name) if isinstance(l, DB.Level) else (None, "?")


vr = view.GetViewRange()
rows, zs = [], []
for label, plane in PLANES:
    lvl, lname = resolve(vr.GetLevelId(plane))
    off = vr.GetOffset(plane)
    if lvl is None:
        z = assoc.ProjectElevation - UNLIMITED
        rows.append([label, lname, "-", "unlimited"])
    else:
        z = lvl.ProjectElevation + off
        rows.append([label, lname, ft_in(off),
                     ft_in(lvl.Elevation + off)])
    zs.append(z)
zmin, zmax = min(zs), max(zs)
if zmax - zmin < 0.1:
    zmax = zmin + 0.1

# ---------------------------------------------------------- plan extent
cb = view.CropBox
ct = cb.Transform
bx = DB.XYZ(ct.BasisX.X, ct.BasisX.Y, 0)
if bx.GetLength() < 1e-9:
    bx = DB.XYZ.BasisX
bx = bx.Normalize()
by = DB.XYZ(-bx.Y, bx.X, 0)
t = DB.Transform.Identity
t.Origin = DB.XYZ(ct.Origin.X, ct.Origin.Y, 0)
t.BasisX, t.BasisY, t.BasisZ = bx, by, DB.XYZ.BasisZ
us, vs = [], []
for x in (cb.Min.X, cb.Max.X):
    for y in (cb.Min.Y, cb.Max.Y):
        p = ct.OfPoint(DB.XYZ(x, y, cb.Min.Z))
        d = DB.XYZ(p.X - t.Origin.X, p.Y - t.Origin.Y, 0)
        us.append(d.DotProduct(bx))
        vs.append(d.DotProduct(by))
box = DB.BoundingBoxXYZ()
box.Transform = t
box.Min = DB.XYZ(min(us) - XY_PAD, min(vs) - XY_PAD, zmin)
box.Max = DB.XYZ(max(us) + XY_PAD, max(vs) + XY_PAD, zmax)

# ---------------------------------------------------------- 3D view
v3 = next((v for v in DB.FilteredElementCollector(doc).OfClass(DB.View3D)
           if not v.IsTemplate and v.Name == VIEW_NAME), None)
with revit.Transaction("MCC: View Range 3D"):
    if v3 is None:
        vft = next(t for t in DB.FilteredElementCollector(doc)
                   .OfClass(DB.ViewFamilyType)
                   if t.ViewFamily == DB.ViewFamily.ThreeDimensional)
        v3 = DB.View3D.CreateIsometric(doc, vft.Id)
        v3.Name = VIEW_NAME
        try:
            v3.ViewTemplateId = DB.ElementId.InvalidElementId
            v3.DisplayStyle = DB.DisplayStyle.ShadingWithEdges
            v3.DetailLevel = DB.ViewDetailLevel.Fine
        except Exception:
            pass
    v3.IsSectionBoxActive = True
    v3.SetSectionBox(box)
cfg.set_option(cfg_key, view.Id.IntegerValue)
script.save_config()

# ---------------------------------------------------------- report
output.print_md("## View range - {}".format(view.Name))
output.print_table(rows, columns=["Plane", "Level", "Offset",
                                  "Elevation"])
output.print_md("3D section box: {} to {} ({} tall){}".format(
    ft_in(zmin - (assoc.ProjectElevation - assoc.Elevation)),
    ft_in(zmax - (assoc.ProjectElevation - assoc.Elevation)),
    ft_in(zmax - zmin),
    "" if view.CropBoxActive else
    "  -  the plan's crop is off, so the box uses its full crop extent"))
if any("Level Above" in r[1] or "Level Below" in r[1] for r in rows):
    output.print_md("**Note:** part of this range is tied to another "
                    "level - soffit plans should use Associated Level.")

# ---------------------------------------------------------- show it
XAML = """
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCC View Range 3D" Width="760" Height="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <DockPanel>
    <TextBlock x:Name="info" DockPanel.Dock="Top" Margin="8,6"
               FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap"/>
    <Grid x:Name="host"/>
  </DockPanel>
</Window>
"""
SLOT = "mcc_view_range_3d_window"


class RangeWindow(forms.WPFWindow):
    """Floating live 3D preview of the range view (Revit PreviewControl).
    Zoom with the wheel, orbit with Shift + wheel-drag."""

    def __init__(self, v3d, title, info):
        forms.WPFWindow.__init__(self, XAML, literal_string=True)
        self.Title = title
        self.info.Text = info
        self.pc = UI.PreviewControl(doc, v3d.Id)
        self.host.Children.Add(self.pc)
        self.Closed += self.on_closed

    def on_closed(self, sender, args):
        try:
            self.pc.Dispose()
        except Exception:
            pass
        try:
            System.AppDomain.CurrentDomain.SetData(SLOT, None)
        except Exception:
            pass


def open_tab():
    uidoc.RequestViewChange(v3)
    if TILE:
        cmd = UI.RevitCommandId.LookupPostableCommandId(
            UI.PostableCommand.TileWindows)
        if cmd is not None and uidoc.Application.CanPostCommand(cmd):
            uidoc.Application.PostCommand(cmd)


info = "  |  ".join("{}: {} {}".format(r[0], r[1].split(" (")[0],
                                         r[2] if r[2] != "-" else "")
                    .strip() for r in rows)
shown = False
if POPOUT:
    try:
        import System
        # one window: close the one from the last run, keep its spot
        old = System.AppDomain.CurrentDomain.GetData(SLOT)
        left = top = w = h = None
        if old is not None:
            try:
                left, top, w, h = old.Left, old.Top, old.Width, old.Height
                old.Close()
            except Exception:
                pass
        win = RangeWindow(v3, "View Range 3D - {}".format(view.Name), info)
        if left is not None:
            win.WindowStartupLocation = \
                System.Windows.WindowStartupLocation.Manual
            win.Left, win.Top, win.Width, win.Height = left, top, w, h
        System.AppDomain.CurrentDomain.SetData(SLOT, win)
        win.show(modal=False)
        shown = True
    except Exception as ex:
        output.print_md("Floating window didn't open ({}) - opening the 3D "
                        "as a tab instead.".format(ex))
if not shown:
    try:
        open_tab()
    except Exception:
        output.print_md("Open **{}** from the browser and tile windows "
                        "(WT).".format(VIEW_NAME))
