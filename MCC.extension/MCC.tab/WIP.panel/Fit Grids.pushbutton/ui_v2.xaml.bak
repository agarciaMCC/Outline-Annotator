<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fit Grids" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    <StackPanel Margin="14">
        <!-- views -->
        <DockPanel Margin="0,0,0,4">
            <TextBlock x:Name="lbl_count" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="All" Width="44" Height="22" Margin="0,0,4,0"
                        Click="views_all"/>
                <Button Content="None" Width="44" Height="22"
                        Click="views_none"/>
            </StackPanel>
        </DockPanel>
        <TextBox x:Name="txt_filter" Height="24" Padding="4,2" Margin="0,0,0,4"
                 VerticalContentAlignment="Center" TextChanged="filter_changed"
                 ToolTip="Type to filter the view list"/>
        <Border BorderBrush="#BBBBBB" BorderThickness="1" Padding="6,4"
                Margin="0,0,0,10">
            <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnl_views"/>
            </ScrollViewer>
        </Border>

        <!-- ends -->
        <GroupBox Header="Grid ends" Padding="8,6" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="No crop: distance past the slab (ft)"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="txt_margin" Height="24"
                             Padding="4,2" VerticalContentAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Crop on: inset from crop edge (paper inches)"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="txt_inset" Height="24"
                             Padding="4,2" VerticalContentAlignment="Center"/>
                </Grid>
                <CheckBox x:Name="chk_cap" Margin="0,2,0,0"
                          Content="Crop on: also stop at the slab line if it comes first"/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#666666"
                           Text="Parallel grids end on a common line so bubbles line up. Bubble visibility is left as it is. Changes are view-specific (2D) only."/>
            </StackPanel>
        </GroupBox>

        <DockPanel>
            <CheckBox x:Name="chk_default" Content="Set as default"
                      VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Height="28" Margin="0,0,8,0"
                        IsCancel="True" Click="cancel_click"/>
                <Button Content="Apply" Width="80" Height="28"
                        IsDefault="True" Click="ok_click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
