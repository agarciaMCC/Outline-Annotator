# -*- coding: utf-8 -*-
"""Trims grid extents IN THIS VIEW ONLY so they end a set distance past
the slab shown (room for dimension tiers and bubbles). Uses Revit's
view-specific datum extents; other views are not affected."""
__title__ = "Fit\nGrids"
__author__ = "MCC ENG"

from pyrevit import revit, DB, forms, script
import mcc_view as V

doc = revit.doc
view = doc.ActiveView
output = script.get_output()

# =====================================================================
# CONFIG
# =====================================================================
GRID_MARGIN = 16.0          # ft past the slab extent to end each grid
                            # (edge dims ~4-7 ft, grid dims ~10-13 ft,
                            # then the bubble)
# =====================================================================

if not isinstance(view, DB.ViewPlan) or view.GenLevel is None:
    forms.alert("Open the soffit plan view first.", exitscript=True)

floors, slab_level = V.soffit_floors(doc, view)
ext = V.plan_extent(floors, view) if floors else None
if ext is None:
    forms.alert("No floors visible in this view to fit to.", exitscript=True)

margin = forms.ask_for_string(
    default=str(GRID_MARGIN),
    prompt="Distance past the slab to end grids (ft)", title="Fit Grids")
try:
    margin = float(margin)
except (TypeError, ValueError):
    script.exit()

xmin, ymin, xmax, ymax = (ext[0] - margin, ext[1] - margin,
                          ext[2] + margin, ext[3] + margin)


def clip(p0, u):
    """Parameter range [t0, t1] where p0 + t*u lies inside the box."""
    t0, t1 = -1e9, 1e9
    for pc, uc, lo, hi in ((p0[0], u[0], xmin, xmax),
                           (p0[1], u[1], ymin, ymax)):
        if abs(uc) < 1e-9:
            if pc < lo or pc > hi:
                return None
            continue
        ta, tb = (lo - pc) / uc, (hi - pc) / uc
        if ta > tb:
            ta, tb = tb, ta
        t0, t1 = max(t0, ta), min(t1, tb)
    return (t0, t1) if t0 < t1 else None


rows, done, skipped = [], 0, 0
with revit.Transaction("MCC: Fit grids to slab"):
    for g, g0, u, n in V.straight_grids(doc, view):
        cur = V.view_curve(g, view)
        e0, e1 = cur.GetEndPoint(0), cur.GetEndPoint(1)
        rng = clip(g0, u)
        if rng is None:
            skipped += 1
            rows.append([g.Name, "outside slab box - left alone"])
            continue
        t0, t1 = rng
        # keep the original end order so bubbles stay on the same ends
        d = cur.Direction
        same = (d.X * u[0] + d.Y * u[1]) > 0
        a = DB.XYZ(g0[0] + u[0] * t0, g0[1] + u[1] * t0, e0.Z)
        b = DB.XYZ(g0[0] + u[0] * t1, g0[1] + u[1] * t1, e0.Z)
        line = DB.Line.CreateBound(a, b) if same else \
            DB.Line.CreateBound(b, a)
        try:
            g.SetCurveInView(DB.DatumExtentType.ViewSpecific, view, line)
            done += 1
            rows.append([g.Name, "{:.1f} ft long".format(t1 - t0)])
        except Exception as ex:
            skipped += 1
            rows.append([g.Name, "failed: {}".format(ex)])

output.print_md("## Fit grids: {}".format(view.Name))
output.print_md("**Trimmed:** {}   **Skipped:** {}   (view-specific only; "
                "margin {} ft)".format(done, skipped, margin))
output.print_table(rows, columns=["Grid", "Result"])
