from pyrevit import revit, DB, UI, forms, script

try:
    from pyrevit.revit import dc3dserver
except Exception:
    dc3dserver = None

cfg = None          # set by run()
cfg_key = "vr3d_last"

# =====================================================================
VIEW_NAME = "MCC VIEW RANGE 3D"
XY_PAD = 1.0          # ft added around the crop for the section box
UNLIMITED = 50.0      # ft used for an "Unlimited" top / view depth
Z_PAD = 0.05          # ft - keeps the planes just inside the section box
BEYOND = 3.0          # ft of extra model shown with "Show beyond range"
FILL_T = 185          # plane fill transparency 0 (solid) - 255 (invisible)
STEPS = [("1/2\"", 1 / 24.0), ("1\"", 1 / 12.0), ("3\"", 0.25),
         ("6\"", 0.5), ("1'-0\"", 1.0)]
DEFAULT_STEP = 1
SLOT = "mcc_view_range_3d_window"
USE_PREVIEW = False   # True = embedded 3D preview pane in the window
                      # False = the 3D opens as a tab tiled beside the plan
TX = "MCC: View Range 3D"         # our transactions - ignored by live refresh
# =====================================================================

# key, label, plane, color (r, g, b)
PLANES = [("top", "Top", DB.PlanViewPlane.TopClipPlane, (40, 110, 220)),
          ("cut", "Cut plane", DB.PlanViewPlane.CutPlane, (215, 45, 45)),
          ("bot", "Bottom", DB.PlanViewPlane.BottomClipPlane, (35, 155, 70)),
          ("dep", "View depth", DB.PlanViewPlane.ViewDepthPlane,
           (230, 135, 20))]
PLAN_TYPES = (DB.ViewType.FloorPlan, DB.ViewType.CeilingPlan,
              DB.ViewType.EngineeringPlan)


# ---------------------------------------------------------- helpers
class _Null(object):
    def write(self, *a):
        pass

    def flush(self):
        pass


_NULL = _Null()


def safe(fn):
    """Never let an exception escape a WPF / Revit callback - an unhandled
    .NET exception there takes Revit down."""
    def wrapped(*args):
        try:
            return fn(*args)
        except Exception:
            try:
                args[0].set_status(traceback.format_exc(), True)
            except Exception:
                pass
    return wrapped


def eid_int(eid):
    try:
        return eid.Value            # Revit 2024+
    except AttributeError:
        return eid.IntegerValue


def ft_in(v):
    """Feet -> 4'-0 1/2" style (signed, nearest 1/8")."""
    sign = "-" if v < -1e-9 else ""
    v = abs(v)
    eighths = int(round(v * 96))
    ft, rem = divmod(eighths, 96)
    whole, frac = divmod(rem, 8)
    s = "{}".format(whole)
    if frac:
        n, d = frac, 8
        while n % 2 == 0:
            n, d = n // 2, d // 2
        s += " {}/{}".format(n, d)
    return "{}{}'-{}\"".format(sign, ft, s)


def _num(tok):
    tok = tok.strip()
    if not tok:
        return 0.0
    if "/" in tok:
        a, b = tok.split("/", 1)
        return float(a) / float(b)
    return float(tok)


def parse_ft_in(text):
    """2'-6", 2' 6 1/2", -6", 30", 2.5 (feet), 0 -> feet, or None."""
    s = (text or "").strip()
    for a, b in ((u"’", "'"), (u"′", "'"), (u"”", '"'),
                 (u"″", '"'), ("''", '"')):
        s = s.replace(a, b)
    if not s:
        return None
    neg = s.startswith("-")
    s = s.lstrip("+-").strip()
    try:
        if "'" in s:
            f, i = s.split("'", 1)
            feet = _num(f)
            i = i.replace('"', "").strip().lstrip("-").strip()
        elif '"' in s:
            feet, i = 0.0, s.replace('"', "").strip()
        else:
            return (-1 if neg else 1) * _num(s)
        inch = sum(_num(t) for t in re.split(r"[\s-]+", i) if t)
        v = feet + inch / 12.0
        return -v if neg else v
    except (ValueError, ZeroDivisionError):
        return None


def get_levels(d):
    return sorted(DB.FilteredElementCollector(d).OfClass(DB.Level),
                  key=lambda l: l.ProjectElevation)


def resolve(levels, assoc, lid):
    """Level for a view-range level id (Associated / Above / Below /
    Unlimited / a level). Returns (level or None, label)."""
    n = eid_int(lid)
    if n == eid_int(DB.PlanViewRange.Current):
        return assoc, "Associated ({})".format(assoc.Name)
    if n == eid_int(DB.PlanViewRange.Unlimited):
        return None, "Unlimited"
    i = next((k for k, l in enumerate(levels)
              if eid_int(l.Id) == eid_int(assoc.Id)), None)
    if n == eid_int(DB.PlanViewRange.LevelAbove):
        l = levels[i + 1] if i is not None and i + 1 < len(levels) else None
        return l, "Level Above ({})".format(l.Name if l else "none")
    if n == eid_int(DB.PlanViewRange.LevelBelow):
        l = levels[i - 1] if i else None
        return l, "Level Below ({})".format(l.Name if l else "none")
    l = next((x for x in levels if eid_int(x.Id) == n), None)
    return (l, l.Name) if l else (None, "?")


def plane_z(levels, assoc, key, lid, off):
    """Internal Z of a plane, and whether it is unlimited."""
    lvl, _ = resolve(levels, assoc, lid)
    if lvl is None:
        sign = 1 if key == "top" else -1
        return assoc.ProjectElevation + sign * UNLIMITED, True
    return lvl.ProjectElevation + off, False


def controlling_template(d, plan):
    """The view template if it controls View Range, else None."""
    tid = plan.ViewTemplateId
    if tid is None or tid == DB.ElementId.InvalidElementId:
        return None
    tmpl = d.GetElement(tid)
    if tmpl is None:
        return None
    vr_id = eid_int(DB.ElementId(DB.BuiltInParameter.PLAN_VIEW_RANGE))
    free = [eid_int(i) for i in tmpl.GetNonControlledTemplateParameterIds()]
    return None if vr_id in free else tmpl


def compute(d, plan, beyond):
    """Everything the window and the 3D need for one plan."""
    levels = get_levels(d)
    assoc = plan.GenLevel
    base = assoc.ProjectElevation - assoc.Elevation   # z of elevation 0
    vr = plan.GetViewRange()
    planes = []
    for key, label, plane, rgb in PLANES:
        lid, off = vr.GetLevelId(plane), vr.GetOffset(plane)
        _, lname = resolve(levels, assoc, lid)
        z, unl = plane_z(levels, assoc, key, lid, off)
        planes.append(dict(key=key, label=label, plane=plane, rgb=rgb,
                           lid=lid, off=off, lname=lname, z=z,
                           unlimited=unl, elev=z - base))
    zs = [p["z"] for p in planes]
    pad = BEYOND if beyond else Z_PAD
    zmin, zmax = min(zs) - pad, max(zs) + pad

    # plan extent (rotated crops too)
    cb = plan.CropBox
    ct = cb.Transform
    bx = DB.XYZ(ct.BasisX.X, ct.BasisX.Y, 0)
    bx = bx.Normalize() if bx.GetLength() > 1e-9 else DB.XYZ.BasisX
    by = DB.XYZ(-bx.Y, bx.X, 0)
    t = DB.Transform.Identity
    t.Origin = DB.XYZ(ct.Origin.X, ct.Origin.Y, 0)
    t.BasisX, t.BasisY, t.BasisZ = bx, by, DB.XYZ.BasisZ
    us, vs = [], []
    for x in (cb.Min.X, cb.Max.X):
        for y in (cb.Min.Y, cb.Max.Y):
            p = ct.OfPoint(DB.XYZ(x, y, cb.Min.Z))
            dv = DB.XYZ(p.X - t.Origin.X, p.Y - t.Origin.Y, 0)
            us.append(dv.DotProduct(bx))
            vs.append(dv.DotProduct(by))
    uv = (min(us), max(us), min(vs), max(vs))
    box = DB.BoundingBoxXYZ()
    box.Transform = t
    box.Min = DB.XYZ(uv[0] - XY_PAD, uv[2] - XY_PAD, zmin)
    box.Max = DB.XYZ(uv[1] + XY_PAD, uv[3] + XY_PAD, zmax)

    # the real crop outline (polygon crops) for the plane edges
    segs = []
    try:
        if plan.CropBoxActive:
            for loop in plan.GetCropRegionShapeManager().GetCropShape():
                for c in loop:
                    pts = list(c.Tessellate())
                    segs.extend(zip(pts[:-1], pts[1:]))
    except Exception:
        segs = []

    watch = set([eid_int(plan.Id)] + [eid_int(l.Id) for l in levels])
    if plan.ViewTemplateId != DB.ElementId.InvalidElementId:
        watch.add(eid_int(plan.ViewTemplateId))
    sb = plan.get_Parameter(DB.BuiltInParameter.VIEWER_VOLUME_OF_INTEREST_CROP)
    if sb is not None and sb.AsElementId() != DB.ElementId.InvalidElementId:
        watch.add(eid_int(sb.AsElementId()))

    return dict(levels=levels, assoc=assoc, planes=planes, box=box, t=t,
                uv=uv, segs=segs, watch=watch,
                tmpl=controlling_template(d, plan))


def same_box(a, b, tol=1e-4):
    try:
        return (a.Min.IsAlmostEqualTo(b.Min, tol)
                and a.Max.IsAlmostEqualTo(b.Max, tol)
                and a.Transform.Origin.IsAlmostEqualTo(b.Transform.Origin, tol)
                and a.Transform.BasisX.IsAlmostEqualTo(b.Transform.BasisX, tol))
    except Exception:
        return False


# ---------------------------------------------------------- 3D graphics
def build_meshes(state):
    """One colored translucent quad + outline per plane."""
    if dc3dserver is None:
        return []
    M, Tri, Edge = dc3dserver.Mesh, dc3dserver.Triangle, dc3dserver.Edge
    t = state["t"]
    u0, u1, v0, v1 = state["uv"]
    up, dn = DB.XYZ.BasisZ, DB.XYZ.BasisZ.Negate()
    meshes, filled = [], []
    for p in state["planes"]:
        z = p["z"]
        r, g, b = p["rgb"]
        fill = DB.ColorWithTransparency(r, g, b, FILL_T)
        line = DB.ColorWithTransparency(r, g, b, 0)
        q = [t.OfPoint(DB.XYZ(u, v, z))
             for u, v in ((u0, v0), (u1, v0), (u1, v1), (u0, v1))]
        tris = []
        if not any(abs(z - fz) < 0.01 for fz in filled):   # no z-fighting
            filled.append(z)
            tris = [Tri(q[0], q[1], q[2], up, fill),
                    Tri(q[0], q[2], q[3], up, fill),
                    Tri(q[0], q[2], q[1], dn, fill),
                    Tri(q[0], q[3], q[2], dn, fill)]
        if state["segs"]:
            edges = [Edge(DB.XYZ(a.X, a.Y, z), DB.XYZ(c.X, c.Y, z), line)
                     for a, c in state["segs"]]
        else:
            edges = [Edge(q[i], q[i - 1], line) for i in range(4)]
        meshes.append(M(edges, tris))
    return meshes


if dc3dserver is not None:
    class PlaneServer(dc3dserver.Server):
        """Draws the planes only in our 3D view (+ sections/elevations)."""

        def __init__(self, ui_doc):
            self.view_id = -1
            self.in_sections = True
            dc3dserver.Server.__init__(
                self, guid=System.Guid.NewGuid(), uidoc=ui_doc,
                name="MCC View Range 3D",
                description="View range planes", vendor_id="MCC")

        def CanExecute(self, view):
            try:
                if not self.meshes:
                    return False
                if not self.uidoc.Document.Equals(view.Document):
                    return False
                if view.ViewType == DB.ViewType.ThreeD:
                    return eid_int(view.Id) == self.view_id
                return self.in_sections and view.ViewType in (
                    DB.ViewType.Section, DB.ViewType.Elevation)
            except Exception:
                return False

        # pyRevit's versions print errors - printing from inside a Revit
        # render callback can crash it, so run them silenced.
        def RenderScene(self, view, display_style):
            old = sys.stdout
            sys.stdout = _NULL
            try:
                dc3dserver.Server.RenderScene(self, view, display_style)
            except Exception:
                pass
            finally:
                sys.stdout = old

        def GetBoundingBox(self, view):
            old = sys.stdout
            sys.stdout = _NULL
            try:
                return dc3dserver.Server.GetBoundingBox(self, view)
            except Exception:
                return None
            finally:
                sys.stdout = old
else:
    PlaneServer = None


# ---------------------------------------------------------- API bridge
class Bridge(UI.IExternalEventHandler):
    """Runs the window's jobs inside Revit's API context."""

    def __init__(self):
        self.jobs = []
        self.win = None
        self.server = None
        self.shutdown = False
        self.event = None

    def queue(self, job):
        if job not in self.jobs:
            self.jobs.append(job)
        self.event.Raise()

    def Execute(self, uiapp):
        jobs, self.jobs = self.jobs, []
        try:
            if self.shutdown:
                if self.server is not None:
                    self.server.meshes = []
                    self.server.remove_server()
                    self.server = None
                try:
                    uiapp.ActiveUIDocument.UpdateAllOpenViews()
                except Exception:
                    pass
                return
            if self.win is not None:
                self.win.run_jobs(uiapp, jobs)
        except Exception:
            if self.win is not None:
                self.win.set_status(traceback.format_exc(), True)

    def GetName(self):
        return "MCC View Range 3D"


def tile_command():
    """Revit's Tile Views command (the enum name changed between versions:
    TileViews in current Revit, TileWindows in old)."""
    for name in ("TileViews", "TileWindows"):
        pc = getattr(UI.PostableCommand, name, None)
        if pc is not None:
            try:
                cmd = UI.RevitCommandId.LookupPostableCommandId(pc)
                if cmd is not None:
                    return cmd
            except Exception:
                pass
    try:
        return UI.RevitCommandId.LookupCommandId("ID_WINDOW_TILE")
    except Exception:
        return None


def get_or_make_3d(d):
    v3 = next((v for v in DB.FilteredElementCollector(d).OfClass(DB.View3D)
               if not v.IsTemplate and v.Name == VIEW_NAME), None)
    if v3 is not None:
        return v3
    vft = next(t for t in DB.FilteredElementCollector(d)
               .OfClass(DB.ViewFamilyType)
               if t.ViewFamily == DB.ViewFamily.ThreeDimensional)
    v3 = DB.View3D.CreateIsometric(d, vft.Id)
    v3.Name = VIEW_NAME
    try:
        v3.ViewTemplateId = DB.ElementId.InvalidElementId
        v3.DisplayStyle = DB.DisplayStyle.ShadingWithEdges
        v3.DetailLevel = DB.ViewDetailLevel.Fine
    except Exception:
        pass
    return v3


# ---------------------------------------------------------- window
def _hex(rgb):
    return "#{:02X}{:02X}{:02X}".format(*rgb)


def _xaml():
    rows = []
    for i, (k, label, _p, rgb) in enumerate(PLANES):
        rows.append("""
      <Rectangle Grid.Row="{r}" Grid.Column="0" Width="14" Height="14"
                 Fill="{c}" Margin="0,0,6,0"/>
      <TextBlock Grid.Row="{r}" Grid.Column="1" Text="{label}"
                 VerticalAlignment="Center"/>
      <ComboBox x:Name="cb_{k}" Grid.Row="{r}" Grid.Column="2"
                Margin="6,3,4,3"/>
      <TextBox x:Name="tb_{k}" Grid.Row="{r}" Grid.Column="3" Width="78"
               Margin="0,3" VerticalContentAlignment="Center"/>
      <StackPanel Grid.Row="{r}" Grid.Column="4" Orientation="Horizontal">
        <Button x:Name="dn_{k}" Content="&#x2212;" Width="22" Margin="3,3,1,3"/>
        <Button x:Name="up_{k}" Content="+" Width="22" Margin="1,3"/>
      </StackPanel>
      <TextBlock x:Name="el_{k}" Grid.Row="{r}" Grid.Column="5"
                 Margin="6,0,0,0" VerticalAlignment="Center"
                 Foreground="#555"/>""".format(r=i + 1, k=k, label=label,
                                               c=_hex(rgb)))
    return """
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCC View Range 3D" Width="1120" Height="620"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="12">
  <DockPanel>
    <ScrollViewer DockPanel.Dock="Left" Width="470"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10">
      <TextBlock x:Name="hdr" FontWeight="Bold" FontSize="13"
                 TextWrapping="Wrap"/>
      <TextBlock x:Name="sub" Foreground="#555" TextWrapping="Wrap"
                 Margin="0,2,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="2" Text="Level" Margin="6,0" Foreground="#888"/>
        <TextBlock Grid.Column="3" Text="Offset" Foreground="#888"/>
        <TextBlock Grid.Column="5" Text="Elevation" Margin="6,0"
                   Foreground="#888"/>
        """ + "".join(rows) + """
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Nudge step" VerticalAlignment="Center"/>
        <ComboBox x:Name="cb_step" Width="64" Margin="6,0"/>
        <CheckBox x:Name="chk_auto" Content="Apply each change right away"
                  VerticalAlignment="Center" Margin="6,0,0,0"/>
      </StackPanel>
      <CheckBox x:Name="chk_tmpl" Margin="0,8,0,0" Visibility="Collapsed">
        <TextBlock x:Name="tmpl_txt" TextWrapping="Wrap" Width="420"/>
      </CheckBox>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="btn_apply" Content="Apply" Width="80"
                Margin="0,0,6,0"/>
        <Button x:Name="btn_revert" Content="Revert" Width="80"
                Margin="0,0,6,0" ToolTip="Back to the range this plan had
when the window picked it up"/>
        <Button x:Name="btn_tab" Content="Split view" Width="100"/>
      </StackPanel>
      <GroupBox Header="Options" Margin="0,12,0,0">
        <StackPanel Margin="4">
          <CheckBox x:Name="chk_live"
                    Content="Live refresh when the plan / levels change"/>
          <CheckBox x:Name="chk_follow" Margin="0,3,0,0"
                    Content="Follow the active plan view"/>
          <CheckBox x:Name="chk_planes" Margin="0,3,0,0"
                    Content="Show the planes in color"/>
          <CheckBox x:Name="chk_sect" Margin="0,3,0,0"
                    Content="Also show plane lines in sections / elevations"/>
          <CheckBox x:Name="chk_only" Margin="0,3,0,0"
                    Content="Split view: close other open views before tiling"/>
          <CheckBox x:Name="chk_beyond" Margin="0,3,0,0"
                    Content="Show 3' of model beyond the range"/>
        </StackPanel>
      </GroupBox>
      <TextBlock x:Name="status" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                 Text="Preview: wheel = zoom, Shift + wheel-drag = orbit.
Offsets: 2'-6&quot;, -6&quot;, 1 1/2&quot;, 2.5 (feet). Enter applies."/>
    </StackPanel>
    </ScrollViewer>
    <Border x:Name="hostbox" BorderBrush="#CCC" BorderThickness="1"
            Margin="0,10,10,10">
      <Grid x:Name="host"/>
    </Border>
  </DockPanel>
</Window>
"""


OPTS = [("chk_auto", True), ("chk_live", True), ("chk_follow", True),
        ("chk_planes", True), ("chk_sect", True), ("chk_beyond", False),
        ("chk_only", True)]


class RangeWindow(forms.WPFWindow):

    def __init__(self, d, ui_doc, plan, v3d, bridge, server):
        forms.WPFWindow.__init__(self, _xaml(), literal_string=True)
        self.doc, self.uidoc, self.uiapp = d, ui_doc, ui_doc.Application
        self.plan, self.v3, self.bridge, self.server = plan, v3d, bridge, server
        self.state = None
        self._tile_pending = False
        self.choices = {}
        self.original = None
        self._loading = True

        for name, default in OPTS:
            val = cfg.get_option("vr3d_" + name, default)
            getattr(self, name).IsChecked = bool(val)
        for label, _v in STEPS:
            self.cb_step.Items.Add(label)
        self.cb_step.SelectedIndex = DEFAULT_STEP
        if server is None:
            self.chk_planes.IsEnabled = self.chk_sect.IsEnabled = False
            self.chk_planes.Content = "Show the planes (needs pyRevit's " \
                                      "dc3dserver - not found)"

        for k, _l, _p, _c in PLANES:
            getattr(self, "up_" + k).Click += self._nudge(k, 1)
            getattr(self, "dn_" + k).Click += self._nudge(k, -1)
            getattr(self, "tb_" + k).KeyDown += self._on_key
            getattr(self, "cb_" + k).SelectionChanged += self._on_combo
        self.btn_apply.Click += self._on_apply
        self.btn_revert.Click += self._on_revert
        self.btn_tab.Click += self._on_tab
        for name in ("chk_planes", "chk_sect", "chk_beyond"):
            getattr(self, name).Click += self._on_option

        self.pc = None
        if USE_PREVIEW:
            self.pc = UI.PreviewControl(d, v3d.Id)
            self.host.Children.Add(self.pc)
        else:
            self.hostbox.Visibility = Visibility.Collapsed
            self.Width = 500

        self._on_changed = self.on_doc_changed
        self._on_activated = self.on_view_activated
        self.uiapp.Application.DocumentChanged += self._on_changed
        self.uiapp.ViewActivated += self._on_activated
        self.Closed += self.on_closed
        self._loading = False

    # ----------------------------------------------------- UI helpers
    def set_status(self, text, error=False):
        self.status.Text = text or ""
        c = WColor.FromRgb(190, 30, 30) if error else WColor.FromRgb(80, 80, 80)
        self.status.Foreground = SolidColorBrush(c)

    def step(self):
        i = self.cb_step.SelectedIndex
        return STEPS[i if i >= 0 else DEFAULT_STEP][1]

    @safe
    def _on_apply(self, sender, args):
        self.apply_ui()

    @safe
    def _on_revert(self, sender, args):
        self.bridge.queue(("revert",))

    @safe
    def _on_tab(self, sender, args):
        self.bridge.queue(("tab",))

    @safe
    def _on_option(self, sender, args):
        self.bridge.queue(("refresh",))

    def _nudge(self, key, sign):
        @safe
        def handler(_self, sender, args):
            tb = getattr(self, "tb_" + key)
            v = parse_ft_in(tb.Text)
            if v is None:
                self.set_status("Can't read the {} offset.".format(key), True)
                return
            tb.Text = ft_in(v + sign * self.step())
            if self.chk_auto.IsChecked:
                self.apply_ui()
        return lambda sender, args: handler(self, sender, args)

    @safe
    def _on_key(self, sender, args):
        if args.Key in (Key.Enter, Key.Return):
            self.apply_ui()

    @safe
    def _on_combo(self, sender, args):
        if not self._loading and self.chk_auto.IsChecked:
            self.apply_ui()

    def read_ui(self):
        """[(plane, level id, offset)] from the fields, or raise
        ValueError with a message."""
        st = self.state
        out, zs = [], {}
        for k, label, plane, _c in PLANES:
            cb = getattr(self, "cb_" + k)
            off = parse_ft_in(getattr(self, "tb_" + k).Text)
            if off is None:
                raise ValueError("Can't read the {} offset.".format(label))
            if cb.SelectedIndex < 0:
                raise ValueError("Pick a level for {}.".format(label))
            lid = self.choices[k][cb.SelectedIndex]
            z, unl = plane_z(st["levels"], st["assoc"], k, lid, off)
            zs[k] = (float("inf") if k == "top" else float("-inf")) \
                if unl else z
            out.append((plane, lid, off))
        tol = 1e-6
        if zs["cut"] > zs["top"] + tol:
            raise ValueError("Cut plane is above Top.")
        if zs["cut"] < zs["bot"] - tol:
            raise ValueError("Cut plane is below Bottom.")
        if zs["dep"] > zs["bot"] + tol:
            raise ValueError("View depth is above Bottom.")
        return out

    def apply_ui(self):
        if self._loading or self.state is None:
            return
        try:
            settings = self.read_ui()
        except ValueError as ex:
            self.set_status(str(ex), True)
            return
        self.bridge.queue(("apply", tuple(settings),
                           bool(self.chk_tmpl.IsChecked)))

    def fill_ui(self):
        st = self.state
        self._loading = True
        try:
            p = self.plan
            self.hdr.Text = p.Name
            self.sub.Text = "Associated level: {}   |   3D view: {}".format(
                st["assoc"].Name, VIEW_NAME)
            assoc_i = next((i for i, l in enumerate(st["levels"])
                            if eid_int(l.Id) == eid_int(st["assoc"].Id)), 0)
            above = st["levels"][assoc_i + 1] \
                if assoc_i + 1 < len(st["levels"]) else None
            below = st["levels"][assoc_i - 1] if assoc_i else None
            seen = []
            for pl in st["planes"]:
                k = pl["key"]
                items = [("Associated ({})".format(st["assoc"].Name),
                          DB.PlanViewRange.Current)]
                if k != "cut":
                    if above is not None:
                        items.append(("Level Above ({})".format(above.Name),
                                      DB.PlanViewRange.LevelAbove))
                    if below is not None:
                        items.append(("Level Below ({})".format(below.Name),
                                      DB.PlanViewRange.LevelBelow))
                    if k in ("top", "dep"):
                        items.append(("Unlimited", DB.PlanViewRange.Unlimited))
                    items += [(l.Name, l.Id) for l in st["levels"]]
                cb = getattr(self, "cb_" + k)
                cb.Items.Clear()
                for label, _i in items:
                    cb.Items.Add(label)
                self.choices[k] = [i for _l, i in items]
                cur = eid_int(pl["lid"])
                idx = next((i for i, (_l, x) in enumerate(items)
                            if eid_int(x) == cur), -1)
                if idx < 0:
                    cb.Items.Add(pl["lname"])
                    self.choices[k].append(pl["lid"])
                    idx = len(items)
                cb.SelectedIndex = idx
                cb.IsEnabled = k != "cut"
                getattr(self, "tb_" + k).Text = ft_in(pl["off"])
                getattr(self, "tb_" + k).IsEnabled = not pl["unlimited"]
                el = "unlimited" if pl["unlimited"] else ft_in(pl["elev"])
                same = next((q["label"] for q in seen
                             if abs(q["z"] - pl["z"]) < 0.01), None)
                if same:
                    el += "  (= {})".format(same)
                getattr(self, "el_" + k).Text = el
                seen.append(pl)
            tmpl = st["tmpl"]
            if tmpl is not None:
                self.chk_tmpl.Visibility = Visibility.Visible
                self.tmpl_txt.Text = ("View template '{}' controls View "
                                      "Range - tick to edit the template "
                                      "(changes every view using it)."
                                      .format(tmpl.Name))
            else:
                self.chk_tmpl.Visibility = Visibility.Collapsed
                self.chk_tmpl.IsChecked = False
        finally:
            self._loading = False

    # ----------------------------------------------------- API jobs
    def run_jobs(self, uiapp, jobs):
        d = self.doc
        if not d.IsValidObject:
            return
        refresh, msg, err = False, None, False
        for job in jobs:
            kind = job[0]
            if kind == "retarget":
                v = d.GetElement(job[1])
                if isinstance(v, DB.ViewPlan) and not v.IsTemplate:
                    self.plan, self.original = v, None
                    refresh = True
            elif kind == "apply":
                try:
                    self._set_range(job[1], job[2])
                    msg = "Applied."
                except Exception as ex:
                    msg, err = "Revit refused the range: {}".format(ex), True
                refresh = True
            elif kind == "revert":
                if self.original:
                    try:
                        self._set_range(self.original,
                                        bool(self.chk_tmpl.IsChecked))
                        msg = "Reverted."
                    except Exception as ex:
                        msg, err = "Couldn't revert: {}".format(ex), True
                refresh = True
            elif kind == "tile":
                self._tile(uiapp)
            elif kind == "tab":
                self._open_tab(uiapp)
            else:
                refresh = True
        if refresh:
            self.refresh()
            if msg:
                self.set_status(msg, err)

    def _set_range(self, settings, use_template):
        target = self.plan
        tmpl = controlling_template(self.doc, self.plan)
        if tmpl is not None:
            if not use_template:
                raise Exception("the view template controls View Range - "
                                "tick the template box to edit it")
            target = tmpl
        vr = target.GetViewRange()
        for plane, lid, off in settings:
            vr.SetLevelId(plane, lid)
            vr.SetOffset(plane, off)
        t = DB.Transaction(self.doc, TX + " - edit range")
        t.Start()
        try:
            target.SetViewRange(vr)
            t.Commit()
        except Exception:
            t.RollBack()
            raise

    def refresh(self):
        d, plan = self.doc, self.plan
        if plan is None or not plan.IsValidObject:
            self.set_status("The plan view is gone - run from a plan.", True)
            return
        st = compute(d, plan, bool(self.chk_beyond.IsChecked))
        self.state = st
        if self.original is None:
            self.original = tuple((p["plane"], p["lid"], p["off"])
                                  for p in st["planes"])
        v3 = self.v3 if self.v3 is not None and self.v3.IsValidObject \
            else None
        need = v3 is None or not v3.IsSectionBoxActive \
            or not same_box(v3.GetSectionBox(), st["box"])
        if need:
            t = DB.Transaction(d, TX)
            t.Start()
            try:
                if v3 is None:
                    v3 = get_or_make_3d(d)
                v3.IsSectionBoxActive = True
                v3.SetSectionBox(st["box"])
                t.Commit()
            except Exception:
                t.RollBack()
                raise
            if self.v3 is None or not self.v3.IsValidObject:
                self.v3 = v3
                self._rehost_preview()
        if self.server is not None:
            self.server.view_id = eid_int(self.v3.Id)
            self.server.in_sections = bool(self.chk_sect.IsChecked)
            self.server.meshes = build_meshes(st) \
                if self.chk_planes.IsChecked else []
        try:
            self.uidoc.UpdateAllOpenViews()
        except Exception:
            pass
        self.fill_ui()
        cfg.set_option(cfg_key, eid_int(plan.Id))
        notes = []
        if any("Level Above" in p["lname"] or "Level Below" in p["lname"]
               for p in st["planes"]):
            notes.append("Part of this range is tied to another level - "
                         "soffit plans should use Associated.")
        if not plan.CropBoxActive:
            notes.append("The plan's crop is off - the box uses its full "
                         "crop extent.")
        self.Title = "View Range 3D - {}".format(plan.Name)
        self.set_status(" ".join(notes) or "Up to date.")

    def _rehost_preview(self):
        if not USE_PREVIEW:
            return
        try:
            self.host.Children.Clear()
            self.pc.Dispose()
        except Exception:
            pass
        self.pc = UI.PreviewControl(self.doc, self.v3.Id)
        self.host.Children.Add(self.pc)

    def _open_tab(self, uiapp):
        """Split view: open the 3D, then tile it with the plan. Revit
        switches views asynchronously, so the tile waits for the 3D to
        become active (see on_view_activated)."""
        ui = uiapp.ActiveUIDocument
        if ui is None or not ui.Document.Equals(self.doc):
            return
        if eid_int(ui.ActiveView.Id) == eid_int(self.v3.Id):
            self._tile(uiapp)
        else:
            self._tile_pending = True
            ui.RequestViewChange(self.v3)

    def _tile(self, uiapp):
        ui = uiapp.ActiveUIDocument
        if ui is None or not ui.Document.Equals(self.doc):
            return
        if self.chk_only.IsChecked:          # just plan + 3D side by side
            keep = (eid_int(self.plan.Id), eid_int(self.v3.Id))
            for u in list(ui.GetOpenUIViews()):
                if eid_int(u.ViewId) not in keep:
                    try:
                        u.Close()
                    except Exception:
                        pass
        cmd = tile_command()
        if cmd is None:
            self.set_status("Couldn't find Revit's Tile Views command - "
                            "press WT to tile.", True)
        elif uiapp.CanPostCommand(cmd):
            uiapp.PostCommand(cmd)

    # ----------------------------------------------------- events
    def on_doc_changed(self, sender, args):
        try:
            if not self.chk_live.IsChecked or self.state is None:
                return
            if not args.GetDocument().Equals(self.doc):
                return
            names = list(args.GetTransactionNames())
            ours = names and all(n.startswith(TX) for n in names)
            if ours and args.Operation == UndoOperation.TransactionCommitted:
                return          # our own refresh / edit (undo still counts)
            ids = set(eid_int(i) for i in args.GetModifiedElementIds())
            ids.update(eid_int(i) for i in args.GetDeletedElementIds())
            if ids & self.state["watch"] or any(
                    isinstance(self.doc.GetElement(i), DB.Level)
                    for i in args.GetAddedElementIds()):
                self.bridge.queue(("refresh",))
        except Exception:
            pass

    def on_view_activated(self, sender, args):
        try:
            v = args.CurrentActiveView
            if (self._tile_pending and v is not None
                    and eid_int(v.Id) == eid_int(self.v3.Id)):
                self._tile_pending = False
                self.bridge.queue(("tile",))
                return
            if not self.chk_follow.IsChecked:
                return
            v = args.CurrentActiveView
            if (v is not None and v.Document.Equals(self.doc)
                    and v.ViewType in PLAN_TYPES and not v.IsTemplate
                    and eid_int(v.Id) != eid_int(self.plan.Id)):
                self.bridge.queue(("retarget", v.Id))
        except Exception:
            pass

    @safe
    def on_closed(self, sender, args):
        try:
            self.uiapp.Application.DocumentChanged -= self._on_changed
        except Exception:
            pass
        try:
            self.uiapp.ViewActivated -= self._on_activated
        except Exception:
            pass
        for name, _d in OPTS:
            try:
                cfg.set_option("vr3d_" + name,
                               bool(getattr(self, name).IsChecked))
            except Exception:
                pass
        try:
            script.save_config()
        except Exception:
            pass
        try:
            self.pc.Dispose()
        except Exception:
            pass
        self.bridge.win = None
        self.bridge.shutdown = True
        try:
            self.bridge.event.Raise()
        except Exception:
            pass
        try:
            if System.AppDomain.CurrentDomain.GetData(SLOT) is self:
                System.AppDomain.CurrentDomain.SetData(SLOT, None)
        except Exception:
            pass


# ---------------------------------------------------------- entry point
def run(doc, uidoc):
    """Called by the View Range 3D button. Everything lives in this module
    (not the button script) because pyRevit clears a script's globals when
    it finishes - the window's handlers then hit NameErrors, which crashed
    Revit."""
    global cfg, cfg_key
    cfg = script.get_config()
    cfg_key = "vr3d_last_" + "".join(c if c.isalnum() else "_"
                                     for c in (doc.Title or "model"))
    view = doc.ActiveView
    if isinstance(view, DB.View3D) and view.Name == VIEW_NAME:
        last = cfg.get_option(cfg_key, 0) or 0
        plan = doc.GetElement(DB.ElementId(int(last))) if last else None
        if not isinstance(plan, DB.ViewPlan):
            forms.alert("Run this from a plan view first.")
            return
        view = plan
    if (not isinstance(view, DB.ViewPlan) or view.IsTemplate
            or view.ViewType not in PLAN_TYPES or view.GenLevel is None):
        forms.alert("Open a plan view (soffit plan) and run View Range 3D.")
        return

    # one window: close the one from the last run, keep its spot
    old = System.AppDomain.CurrentDomain.GetData(SLOT)
    spot = None
    if old is not None:
        try:
            spot = (old.Left, old.Top, old.Width, old.Height)
            old.Close()
        except Exception:
            pass
    cfg = script.get_config()       # re-read: the old window just saved options

    state0 = compute(doc, view, bool(cfg.get_option("vr3d_chk_beyond", False)))
    with revit.Transaction(TX, doc=doc):
        v3 = get_or_make_3d(doc)
        v3.IsSectionBoxActive = True
        v3.SetSectionBox(state0["box"])

    bridge = Bridge()
    bridge.event = UI.ExternalEvent.Create(bridge)
    server = None
    if PlaneServer is not None:
        try:
            server = PlaneServer(uidoc)
        except Exception:
            server = None
    bridge.server = server

    win = RangeWindow(doc, uidoc, view, v3, bridge, server)
    bridge.win = win
    if spot is not None:
        win.WindowStartupLocation = System.Windows.WindowStartupLocation.Manual
        win.Left, win.Top, win.Width, win.Height = spot
    System.AppDomain.CurrentDomain.SetData(SLOT, win)
    win.refresh()
    win.show(modal=False)
    if not USE_PREVIEW:
        try:
            win._open_tab(uidoc.Application)      # split view plan | 3D
        except Exception:
            pass
