"""View Range 3D - window, 3D planes and live link. See the button's
script.py / README."""
import re
import sys
import traceback

import clr
clr.AddReference("PresentationFramework")     # WPF isn't loaded yet
clr.AddReference("PresentationCore")
clr.AddReference("WindowsBase")
import System
from System.Windows import Visibility
from System.Windows.Input import Key
